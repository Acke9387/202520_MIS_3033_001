<Window x:Class="JSON_Chuck_Norris_Jokes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSON_Chuck_Norris_Jokes"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="https://th.bing.com/th/id/OIP.keUd8MbnM9KIwyPSYLXiAAHaED?w=299&amp;h=180&amp;c=7&amp;r=0&amp;o=7&amp;dpr=1.3&amp;pid=1.7&amp;rm=3"/>
    </Window.Background>
    <Grid>
        <Label Content="Select a category" HorizontalAlignment="Left" Margin="53,53,0,0" VerticalAlignment="Top" Background="#99FFFFFF"/>
        <ComboBox x:Name="cboCategories" HorizontalAlignment="Left" Margin="71,86,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtJoke" HorizontalAlignment="Left" Margin="242,223,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="224" Height="163" Background="#BBFFFFFF"/>
        <Button x:Name="btnFetchJoke" Content="Fetch Joke" HorizontalAlignment="Left" Margin="34,170,0,0" VerticalAlignment="Top" Height="85" Width="138">
            <Button.Background>
                <ImageBrush ImageSource="https://www.bing.com/th/id/OIP.lzV3lybzL0XUhk5ZRJm_9gHaEP?w=260&amp;h=211&amp;c=8&amp;rs=1&amp;qlt=90&amp;o=6&amp;dpr=1.3&amp;pid=3.1&amp;rm=2"/>
            </Button.Background>
        </Button>

    </Grid>
</Window>
