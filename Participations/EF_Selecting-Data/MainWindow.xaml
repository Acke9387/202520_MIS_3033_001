<Window x:Class="EF_Selecting_Data.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EF_Selecting_Data"
        mc:Ignorable="d"
        Title="Students and Courses" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Students Section -->
        <StackPanel Grid.Column="0" Margin="0,0,5,0">
            <TextBlock Text="Students" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="lstStudents"  SelectionChanged="lstStudents_SelectionChanged"/>
        </StackPanel>
        
        <!-- Courses Section -->
        <StackPanel Grid.Column="1" Margin="5,0,0,0">
            <TextBlock Text="Courses" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="lstCourses" />
        </StackPanel>
    </Grid>
</Window>
