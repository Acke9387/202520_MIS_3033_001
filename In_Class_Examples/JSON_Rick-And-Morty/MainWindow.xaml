<Window x:Class="JSON_Rick_And_Morty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSON_Rick_And_Morty"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="https://m.media-amazon.com/images/I/81CwjScs2aL._AC_UF1000,1000_QL80_.jpg"/>
    </Window.Background>
    <Grid>
        <ComboBox x:Name="cboCharacters" HorizontalAlignment="Left" Margin="74,103,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cboCharacters_SelectionChanged"/>
        <Image x:Name="imgCharacter" HorizontalAlignment="Left" Height="326" Margin="464,95,0,0" VerticalAlignment="Top" Width="311"/>
        <Label x:Name="lblName" HorizontalAlignment="Left" Margin="495,37,0,0" VerticalAlignment="Top" Background="White" FontSize="36" Width="255" Height="58"/>
        <TextBlock x:Name="tbLink" HorizontalAlignment="Left" Margin="315,269,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="63" Width="204"/>

    </Grid>
</Window>
